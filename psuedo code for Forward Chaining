DATABASE facts = [croaks, eats_flies]
DATABASE rules = [
    IF (croaks AND eats_flies) THEN ADD "frog",
    IF (frog) THEN ADD "green color"
]

PROCEDURE forward_chaining():
    new_fact_added = True

    WHILE new_fact_added IS True:
        new_fact_added = False
        FOR EACH rule IN rules:
            IF conditions of rule ARE MET IN facts AND rule.conclusion NOT IN facts THEN
                ADD rule.conclusion TO facts
                PRINT "Inferred: " + rule.conclusion
                new_fact_added = True
            END IF
        END FOR
    END WHILE
END PROCEDURE
